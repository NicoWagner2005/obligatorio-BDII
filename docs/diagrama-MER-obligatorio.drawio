        <mxCell id="KUaJVT5QebocSt8oMLsm-352" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;Bitacora:&lt;/div&gt;Las tablas __EFMigrationHistory y todas las que tienen el prefijo AspNet forman parte del sistema de cuentas implementado por el framework Identity de .NET, el cual decidimos utilizar en el modelo físico. Este agrega sus propias entidades, las cuales documentamos utilizando ingeniería inversa." vertex="1">
          <mxGeometry height="30" width="190" x="5842" y="-330" as="geometry" />
        </mxCell>
