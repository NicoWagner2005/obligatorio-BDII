<div class="top-row">
    <a class="navbar-brand" href="/dashboard">
        <div class="brand-icon">⚽</div>
        <div>
            <span class="brand-name">Ticketing Mundial</span>
            <span class="brand-sub">UCU · 2026</span>
        </div>
    </a>
</div>

<div class="nav-scrollable">
    <div class="nav-main">
        <nav class="nav flex-column">

            <div class="nav-item">
                <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
                </NavLink>
            </div>

            <AuthorizeView Roles="general">
                <Authorized>
                    <div class="nav-section">Entradas</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/comprar">
                            <span class="bi bi-ticket-nav-menu" aria-hidden="true"></span> Comprar entradas
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/mis-entradas">
                            <span class="bi bi-grid-nav-menu" aria-hidden="true"></span> Mis entradas
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/transferencias">
                            <span class="bi bi-arrow-left-right-nav-menu" aria-hidden="true"></span> Transferencias
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/historial-compras">
                            <span class="bi bi-cart-nav-menu" aria-hidden="true"></span> Historial de compras
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="funcionario">
                <Authorized>
                    <div class="nav-section">Validación</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/funcionario/mis-asignaciones">
                            <span class="bi bi-calendar-check-nav-menu" aria-hidden="true"></span> Mis asignaciones
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/funcionario/validar">
                            <span class="bi bi-check-circle-nav-menu" aria-hidden="true"></span> Validar entrada
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="administrador">
                <Authorized>
                    <div class="nav-section">Administración</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/admin/estadios">
                            <span class="bi bi-building-nav-menu" aria-hidden="true"></span> Estadios
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/admin/eventos">
                            <span class="bi bi-calendar3-nav-menu" aria-hidden="true"></span> Eventos
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/admin/ventas">
                            <span class="bi bi-ticket-nav-menu" aria-hidden="true"></span> Ventas
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/admin/funcionarios">
                            <span class="bi bi-people-nav-menu" aria-hidden="true"></span> Dispositivos
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/admin/asignaciones">
                            <span class="bi bi-person-check-nav-menu" aria-hidden="true"></span> Funcionarios
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/admin/estadisticas">
                            <span class="bi bi-bar-chart-nav-menu" aria-hidden="true"></span> Estadísticas
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

        </nav>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="nav-user-section" onclick:stopPropagation="true">
                <NavLink class="nav-user-link" href="Account/Manage">
                    <div class="nav-avatar">
                        @(context.User.Identity?.Name?.Substring(0,1).ToUpperInvariant() ?? "U")
                    </div>
                    <div class="nav-user-info">
                        <div class="nav-user-name">@context.User.Identity?.Name</div>
                        <div class="nav-user-role">
                            @(context.User.IsInRole("administrador") ? "Administrador"
                              : context.User.IsInRole("funcionario") ? "Funcionario"
                              : "Usuario")
                        </div>
                    </div>
                </NavLink>
                <form action="Account/Logout" method="post" onclick:stopPropagation="true">
                    <AntiforgeryToken />
                    <button type="submit" class="nav-logout-btn" title="Cerrar sesión">
                        <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span>
                    </button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</div>
