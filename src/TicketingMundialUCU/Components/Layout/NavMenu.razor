@implements IDisposable
@inject NavigationManager NavigationManager

<div class="top-row">
    <a class="navbar-brand" href="/dashboard">
        <div class="brand-icon">⚽</div>
        <div>
            <span class="brand-name">Ticketing Mundial</span>
            <span class="brand-sub">UCU · 2026</span>
        </div>
    </a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <div class="nav-main">
        <nav class="nav flex-column">

            <div class="nav-item">
                <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
                </NavLink>
            </div>

            <AuthorizeView Roles="general">
                <Authorized>
                    <div class="nav-section">Entradas</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/comprar">
                            <span class="bi bi-ticket-nav-menu" aria-hidden="true"></span> Comprar entradas
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/mis-entradas">
                            <span class="bi bi-grid-nav-menu" aria-hidden="true"></span> Mis entradas
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/mis-compras">
                            <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> Historial de compras
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="administrador">
                <Authorized>
                    <div class="nav-section">Administración</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/admin/estadios">
                            <span class="bi bi-building-nav-menu" aria-hidden="true"></span> Estadios
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/admin/eventos">
                            <span class="bi bi-calendar3-nav-menu" aria-hidden="true"></span> Eventos
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/admin/ventas">
                            <span class="bi bi-ticket-nav-menu" aria-hidden="true"></span> Ventas
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

        </nav>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="nav-user-section" onclick:stopPropagation="true">
                <NavLink class="nav-user-link" href="Account/Manage">
                    <div class="nav-avatar">
                        @(context.User.Identity?.Name?.Substring(0,1).ToUpperInvariant() ?? "U")
                    </div>
                    <div class="nav-user-info">
                        <div class="nav-user-name">@context.User.Identity?.Name</div>
                        <div class="nav-user-role">
                            @(context.User.IsInRole("administrador") ? "Administrador"
                              : context.User.IsInRole("funcionario") ? "Funcionario"
                              : "Usuario")
                        </div>
                    </div>
                </NavLink>
                <form action="Account/Logout" method="post" onclick:stopPropagation="true">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="nav-logout-btn" title="Cerrar sesión">
                        <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span>
                    </button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
