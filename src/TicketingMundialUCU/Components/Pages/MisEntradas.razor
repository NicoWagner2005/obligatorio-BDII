@page "/mis-entradas"
@using Microsoft.AspNetCore.Authorization
@using TicketingMundialUCU.Data.Daos
@using TicketingMundialUCU.Services
@using System.Security.Claims
@attribute [Authorize(Roles = "general")]
@inject VentaService VentaService
@inject AuthenticationStateProvider AuthProvider
@rendermode InteractiveServer

<PageTitle>Mis Entradas</PageTitle>

<div class="page-header">
    <h1>Mis Entradas</h1>
    <p class="page-subtitle">Entradas disponibles asignadas a tu usuario</p>
</div>

@if (_cargando)
{
    <div class="text-center text-muted py-5">
        <p class="mb-0">Cargando entradas…</p>
    </div>
}
else if (!_entradas.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <div style="font-size:2.5rem;margin-bottom:1rem;opacity:.4">🎫</div>
            <h5 class="fw-semibold mb-1" style="color:var(--text-2)">No tenés entradas disponibles</h5>
            <p class="text-muted small mb-3">Comprá o recibí una transferencia para ver tus entradas acá.</p>
            <a href="/comprar" class="btn btn-primary">Comprar entradas</a>
        </div>
    </div>
}
else
{
    <!-- Entradas disponibles como tickets individuales -->
    @foreach (var entrada in _entradas)
    {
        var estadoPill = entrada.EstadoVenta switch {
            "paga"       => "sp-paid",
            "confirmada" => "sp-confirmed",
            _            => "sp-pending",
        };
        var ticketClass = entrada.EstadoVenta switch {
            "paga"       => "ticket-paid",
            "confirmada" => "ticket-confirmed",
            _            => "ticket-pending",
        };

        <div class="ticket-card @ticketClass mb-2">
            <div class="ticket-header">
                <div class="d-flex align-items-start justify-content-between gap-2">
                    <div>
                        <div class="match-display mb-1">
                            <span class="match-team">@(entrada.EquipoLocal ?? "—")</span>
                            <span class="match-separator">VS</span>
                            <span class="match-team">@(entrada.EquipoVisitante ?? "—")</span>
                        </div>
                        <div style="font-size:.775rem;color:var(--text-3)">
                            @entrada.FechaHoraEvento.ToString("dd MMM yyyy") · @entrada.FechaHoraEvento.ToString("HH:mm") hs
                            · @entrada.NombreEstadio
                        </div>
                    </div>
                    <span class="sector-badge sector-@entrada.IdSector flex-shrink-0">@entrada.IdSector</span>
                </div>
            </div>
            <div class="ticket-body d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2" style="font-size:.8rem;color:var(--text-2)">
                    <span>Sector <strong>@entrada.IdSector</strong></span>
                    <span class="status-pill @estadoPill">@entrada.EstadoVenta</span>
                </div>
                @if (entrada.IdTokenQr is Guid idTokenQr)
                {
                    <code class="ticket-code">@idTokenQr.ToString().ToUpperInvariant()</code>
                }
                else
                {
                    <span class="text-muted small">Sin token QR activo</span>
                }
            </div>
        </div>
    }
}

@code {
    private List<EntradaDetalle> _entradas = [];
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId is not null)
            _entradas = (await VentaService.GetEntradasByUsuarioAsync(userId)).ToList();

        _cargando = false;
    }
}
