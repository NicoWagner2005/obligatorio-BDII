@page "/mis-entradas"
@using Microsoft.AspNetCore.Authorization
@using TicketingMundialUCU.Data.Daos
@using TicketingMundialUCU.Services
@using System.Security.Claims
@attribute [Authorize(Roles = "general")]
@implements IAsyncDisposable
@inject VentaService VentaService
@inject TokenQrService TokenQrService
@inject QrCodeService QrCodeService
@inject AuthenticationStateProvider AuthProvider
@rendermode InteractiveServer

<PageTitle>Mis Entradas</PageTitle>

<div class="page-header">
    <h1>Mis Entradas</h1>
    <p class="page-subtitle">Entradas disponibles asignadas a tu usuario</p>
</div>

@if (_cargando)
{
    <div class="text-center text-muted py-5">
        <p class="mb-0">Cargando entradas…</p>
    </div>
}
else if (!_entradas.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <div style="font-size:2.5rem;margin-bottom:1rem;opacity:.4">🎫</div>
            <h5 class="fw-semibold mb-1" style="color:var(--text-2)">No tenés entradas disponibles</h5>
            <p class="text-muted small mb-3">Comprá o recibí una transferencia para ver tus entradas acá.</p>
            <a href="/comprar" class="btn btn-primary">Comprar entradas</a>
        </div>
    </div>
}
else
{
    <!-- Entradas disponibles como tickets individuales -->
    @foreach (var entrada in _entradas)
    {
        var estadoPill = entrada.EstadoVenta switch {
            "paga"       => "sp-paid",
            "confirmada" => "sp-confirmed",
            _            => "sp-pending",
        };
        var ticketClass = entrada.EstadoVenta switch {
            "paga"       => "ticket-paid",
            "confirmada" => "ticket-confirmed",
            _            => "ticket-pending",
        };
        var puedeMostrarQr = PuedeMostrarQr(entrada);
        var estaSeleccionada = _entradaQrSeleccionadaId == entrada.IdEntrada;

        <div class="ticket-card @ticketClass @(puedeMostrarQr ? "ticket-clickable" : "") mb-2"
             @onclick="() => ToggleQrAsync(entrada)">
            <div class="ticket-header">
                <div class="d-flex align-items-start justify-content-between gap-2">
                    <div>
                        <div class="match-display mb-1">
                            <span class="match-team">@(entrada.EquipoLocal ?? "—")</span>
                            <span class="match-separator">VS</span>
                            <span class="match-team">@(entrada.EquipoVisitante ?? "—")</span>
                        </div>
                        <div style="font-size:.775rem;color:var(--text-3)">
                            @entrada.FechaHoraEvento.ToString("dd MMM yyyy") · @entrada.FechaHoraEvento.ToString("HH:mm") hs
                            · @entrada.NombreEstadio
                        </div>
                    </div>
                    <span class="sector-badge sector-@entrada.IdSector flex-shrink-0">@entrada.IdSector</span>
                </div>
            </div>
            <div class="ticket-body d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2" style="font-size:.8rem;color:var(--text-2)">
                    <span>Sector <strong>@entrada.IdSector</strong></span>
                    <span class="status-pill @estadoPill">@entrada.EstadoVenta</span>
                </div>
                @if (entrada.CodigoToken is not null)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            disabled="@_cargandoQr"
                            @onclick:stopPropagation="true"
                            @onclick="() => ToggleQrAsync(entrada)">
                        @(estaSeleccionada ? "Ocultar QR" : "Ver QR")
                    </button>
                }
                else if (entrada.EstadoVenta != "paga")
                {
                    <span class="text-muted small">Disponible al pagar</span>
                }
                else
                {
                    <span class="text-muted small">Sin token QR activo</span>
                }
            </div>

            @if (estaSeleccionada)
            {
                <div class="ticket-qr-panel" @onclick:stopPropagation="true">
                    @if (_cargandoQr)
                    {
                        <p class="text-muted small mb-0">Cargando QR…</p>
                    }
                    else if (!string.IsNullOrEmpty(_qrErrorMessage))
                    {
                        <div class="alert alert-warning mb-0">
                            @_qrErrorMessage
                        </div>
                    }
                    else if (_qrActivo is not null && !string.IsNullOrEmpty(_qrDataUri))
                    {
                        <div class="ticket-qr-content">
                            <img class="ticket-qr-image"
                                 src="@_qrDataUri"
                                 alt="Código QR de entrada" />
                            <div class="ticket-qr-detail">
                                <div class="fw-semibold mb-1">Código QR activo</div>
                                <div class="text-muted small mb-2">
                                    Vence el @_qrActivo.FechaExpiracion.ToString("dd MMM yyyy · HH:mm:ss") hs
                                </div>
                                <code class="ticket-code ticket-qr-token">
                                    @_qrActivo.CodigoToken.ToString("D").ToUpperInvariant()
                                </code>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary mt-3"
                                        @onclick:stopPropagation="true"
                                        @onclick="CerrarQr">
                                    Cerrar
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private List<EntradaDetalle> _entradas = [];
    private bool _cargando = true;
    private bool _cargandoQr;
    private string? _userId;
    private Guid? _entradaQrSeleccionadaId;
    private TokenQrActivo? _qrActivo;
    private string? _qrDataUri;
    private string? _qrErrorMessage;
    private CancellationTokenSource? _refreshCancellation;
    private Task? _refreshTask;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        await CargarEntradasAsync();

        _cargando = false;

        _refreshCancellation = new CancellationTokenSource();
        _refreshTask = RefrescarEntradasPeriodicamenteAsync(_refreshCancellation.Token);
    }

    private async Task CargarEntradasAsync()
    {
        if (_userId is not null)
            _entradas = (await VentaService.GetEntradasByUsuarioAsync(_userId)).ToList();

        await SincronizarQrSeleccionadoAsync();
    }

    private static bool PuedeMostrarQr(EntradaDetalle entrada) =>
        entrada.EstadoVenta == "paga" &&
        !entrada.Consumida &&
        entrada.CodigoToken is not null;

    private async Task ToggleQrAsync(EntradaDetalle entrada)
    {
        if (!PuedeMostrarQr(entrada))
            return;

        if (_entradaQrSeleccionadaId == entrada.IdEntrada)
        {
            CerrarQr();
            return;
        }

        _entradaQrSeleccionadaId = entrada.IdEntrada;
        await CargarQrActivoAsync(entrada.IdEntrada);
    }

    private async Task SincronizarQrSeleccionadoAsync()
    {
        if (_entradaQrSeleccionadaId is not Guid idEntrada)
            return;

        var entrada = _entradas.FirstOrDefault(e => e.IdEntrada == idEntrada);
        if (entrada is null || !PuedeMostrarQr(entrada))
        {
            CerrarQr();
            return;
        }

        await CargarQrActivoAsync(idEntrada);
    }

    private async Task CargarQrActivoAsync(Guid idEntrada)
    {
        if (_userId is null)
            return;

        _cargandoQr = true;
        _qrErrorMessage = null;
        _qrActivo = null;
        _qrDataUri = null;

        try
        {
            _qrActivo = await TokenQrService.GetTokenActivoByEntradaAsync(_userId, idEntrada);
            if (_qrActivo is null)
            {
                _qrErrorMessage = "No hay un token QR activo para esta entrada.";
                return;
            }

            _qrDataUri = QrCodeService.GenerateTokenQrDataUri(_qrActivo.CodigoToken);
        }
        catch (Exception ex)
        {
            _qrErrorMessage = ex.Message;
        }
        finally
        {
            _cargandoQr = false;
        }
    }

    private void CerrarQr()
    {
        _entradaQrSeleccionadaId = null;
        _qrActivo = null;
        _qrDataUri = null;
        _qrErrorMessage = null;
        _cargandoQr = false;
    }

    private async Task RefrescarEntradasPeriodicamenteAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        while (await timer.WaitForNextTickAsync(cancellationToken))
        {
            await InvokeAsync(async () =>
            {
                await CargarEntradasAsync();
                StateHasChanged();
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_refreshCancellation is null)
            return;

        await _refreshCancellation.CancelAsync();

        if (_refreshTask is not null)
        {
            try { await _refreshTask; }
            catch (OperationCanceledException) { }
        }

        _refreshCancellation.Dispose();
    }
}

<style>
    .ticket-clickable {
        transition: border-color .15s, box-shadow .15s;
    }

    .ticket-clickable:hover {
        border-color: var(--brand);
        box-shadow: var(--shadow-md);
    }

    .ticket-qr-panel {
        padding: 1rem 1.125rem 1.125rem 1.375rem;
        border-top: 1px dashed var(--border);
        background: #f8fafc;
    }

    .ticket-qr-content {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .ticket-qr-image {
        width: 10rem;
        height: 10rem;
        padding: .5rem;
        border: 1px solid var(--border);
        border-radius: var(--r);
        background: #fff;
    }

    .ticket-qr-detail {
        min-width: 0;
        flex: 1;
    }

    .ticket-qr-token {
        display: inline-block;
        max-width: 100%;
        overflow-wrap: anywhere;
        white-space: normal;
    }
</style>
