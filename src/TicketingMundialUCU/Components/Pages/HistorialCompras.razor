@page "/historial-compras"
@using Microsoft.AspNetCore.Authorization
@using TicketingMundialUCU.Data.Repositories
@using TicketingMundialUCU.Services
@using System.Security.Claims
@attribute [Authorize(Roles = "general")]
@inject VentaService VentaService
@inject AuthenticationStateProvider AuthProvider
@rendermode InteractiveServer

<PageTitle>Historial de Compras</PageTitle>

<div class="page-header">
    <h1>Historial de compras</h1>
    <p class="page-subtitle">Todas tus transacciones de entradas</p>
</div>

@if (_cargando)
{
    <div class="text-center text-muted py-5">
        <p class="mb-0">Cargando historial…</p>
    </div>
}
else if (!_ventas.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <div style="font-size:2.5rem;margin-bottom:1rem;opacity:.4">🛒</div>
            <h5 class="fw-semibold mb-1" style="color:var(--text-2)">Todavía no realizaste compras</h5>
            <p class="text-muted small mb-3">Encontrá los mejores eventos y conseguí tus entradas.</p>
            <a href="/comprar" class="btn btn-primary">Comprar entradas</a>
        </div>
    </div>
}
else
{
    <!-- Resumen superior -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-blue">🛒</div>
                <div class="stat-body">
                    <div class="stat-value">@_ventas.Count</div>
                    <div class="stat-label">Compras realizadas</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-purple">🎫</div>
                <div class="stat-body">
                    <div class="stat-value">@_ventas.Sum(v => v.CantidadEntradas)</div>
                    <div class="stat-label">Entradas totales</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-amber">💵</div>
                <div class="stat-body">
                    <div class="stat-value">$@_ventas.Sum(v => v.MontoTotal).ToString("N0")</div>
                    <div class="stat-label">Total gastado</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-green">✅</div>
                <div class="stat-body">
                    <div class="stat-value">@_ventas.Count(v => v.Estado == "paga")</div>
                    <div class="stat-label">Compras pagas</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de transacciones estilo banco -->
    <div class="card" style="overflow:hidden">
        <div class="card-header d-flex align-items-center justify-content-between" style="padding:.875rem 1.25rem">
            <span class="fw-semibold" style="font-size:.9rem">Transacciones</span>
            <span class="text-muted small">@_ventas.Count resultado@(_ventas.Count != 1 ? "s" : "")</span>
        </div>

        <div style="divide-y:1px solid var(--border)">
            @foreach (var venta in _ventas)
            {
                var estadoPill = venta.Estado switch {
                    "paga"       => "sp-paid",
                    "confirmada" => "sp-confirmed",
                    _            => "sp-pending",
                };
                var iconoBg = venta.Estado switch {
                    "paga"       => "#d1fae5",
                    "confirmada" => "#dbeafe",
                    _            => "#fef3c7",
                };
                var iconoColor = venta.Estado switch {
                    "paga"       => "#059669",
                    "confirmada" => "#2563eb",
                    _            => "#d97706",
                };
                var expanded = _expandidos.Contains(venta.IdVenta);

                <div style="border-bottom:1px solid var(--border)">
                    <!-- Fila principal de la transacción -->
                    <button class="w-100 text-start bg-transparent border-0 p-0"
                            style="cursor:pointer"
                            @onclick="() => ToggleExpand(venta.IdVenta)">
                        <div class="d-flex align-items-center gap-3 px-4 py-3 txn-row">

                            <!-- Icono -->
                            <div style="width:2.4rem;height:2.4rem;border-radius:50%;background:@iconoBg;
                                        display:flex;align-items:center;justify-content:center;
                                        flex-shrink:0;font-size:1rem;color:@iconoColor">
                                🎫
                            </div>

                            <!-- Info principal -->
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="fw-semibold" style="font-size:.875rem">
                                        Compra #@venta.IdVenta
                                    </span>
                                    <span class="status-pill @estadoPill">@venta.Estado</span>
                                </div>
                                <div class="text-muted" style="font-size:.775rem;margin-top:.15rem">
                                    @venta.FechaVenta.ToString("dd MMM yyyy") · @venta.FechaVenta.ToString("HH:mm") hs
                                    · @venta.CantidadEntradas entrada@(venta.CantidadEntradas != 1 ? "s" : "")
                                </div>
                            </div>

                            <!-- Monto + chevron -->
                            <div class="d-flex align-items-center gap-3 flex-shrink-0">
                                <div class="text-end">
                                    <div class="fw-semibold" style="font-size:.95rem">
                                        $@venta.MontoTotal.ToString("N0")
                                    </div>
                                    <div class="text-muted" style="font-size:.7rem">
                                        comisión @((venta.TasaComisionAplicada * 100).ToString("0.#"))%
                                    </div>
                                </div>
                                <span style="color:var(--text-3);font-size:.75rem;transition:transform .15s;
                                             display:inline-block;transform:rotate(@(expanded ? "180deg" : "0deg"))">
                                    ▼
                                </span>
                            </div>

                        </div>
                    </button>

                    <!-- Detalle expandible -->
                    @if (expanded)
                    {
                        <div style="background:var(--bg-2,#f8fafc);border-top:1px solid var(--border);padding:1rem 1.25rem 1rem 4.5rem">
                            @if (_cargandoDetalle.Contains(venta.IdVenta))
                            {
                                <p class="text-muted small mb-0">Cargando detalle…</p>
                            }
                            else if (_detalles.TryGetValue(venta.IdVenta, out var entradas))
                            {
                                @foreach (var entrada in entradas)
                                {
                                    <div class="d-flex align-items-center gap-3 py-2"
                                         style="border-bottom:1px dashed var(--border)">
                                        <span class="sector-badge sector-@entrada.IdSector flex-shrink-0">@entrada.IdSector</span>
                                        <div class="flex-grow-1 min-w-0">
                                            <div class="fw-medium" style="font-size:.825rem">
                                                @(entrada.EquipoLocal ?? "—") vs @(entrada.EquipoVisitante ?? "—")
                                            </div>
                                            <div class="text-muted" style="font-size:.75rem">
                                                @entrada.FechaHoraEvento.ToString("dd MMM yyyy · HH:mm") hs · @entrada.NombreEstadio
                                            </div>
                                        </div>
                                        <div class="text-end flex-shrink-0">
                                            <div class="fw-semibold" style="font-size:.825rem">$@entrada.PrecioUnitario.ToString("N0")</div>
                                            <code class="ticket-code" style="font-size:.65rem">@entrada.IdEntrada.ToString().ToUpper()</code>
                                        </div>
                                    </div>
                                }
                                <div class="d-flex justify-content-end mt-2 pt-1" style="font-size:.8rem;color:var(--text-2)">
                                    <span>Subtotal sin comisión:&nbsp;</span>
                                    <span class="fw-semibold">$@entradas.Sum(e => e.PrecioUnitario).ToString("N0")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<style>
    .txn-row:hover { background: var(--bg-2, #f8fafc); }
</style>

@code {
    private List<VentaResumen> _ventas = [];
    private HashSet<int> _expandidos = [];
    private HashSet<int> _cargandoDetalle = [];
    private Dictionary<int, List<EntradaDetalle>> _detalles = [];
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId is not null)
            _ventas = (await VentaService.GetVentasByUsuarioAsync(userId)).ToList();
        _cargando = false;
    }

    private async Task ToggleExpand(int idVenta)
    {
        if (_expandidos.Contains(idVenta))
        {
            _expandidos.Remove(idVenta);
            return;
        }

        _expandidos.Add(idVenta);

        if (!_detalles.ContainsKey(idVenta))
        {
            _cargandoDetalle.Add(idVenta);
            StateHasChanged();
            var items = (await VentaService.GetDetallesByVentaAsync(idVenta)).ToList();
            _detalles[idVenta] = items;
            _cargandoDetalle.Remove(idVenta);
        }
    }
}
