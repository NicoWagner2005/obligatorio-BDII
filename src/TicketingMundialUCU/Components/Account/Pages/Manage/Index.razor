@page "/Account/Manage"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using TicketingMundialUCU.Data
@using TicketingMundialUCU.Services

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserPhoneService UserPhoneService

<PageTitle>Profile</PageTitle>

<h3>Profile</h3>
<StatusMessage Message="@statusMessage" />

<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <input type="text" value="@username" id="username" class="form-control" placeholder="Choose your username." disabled />
                <label for="username" class="form-label">Username</label>
            </div>

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Phone number</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Input.PhoneNumbers.Count; index++)
                    {
                        var phoneIndex = index;

                        <tr>
                            <th scope="row">@(phoneIndex + 1)</th>
                            <td>
                                <InputText @bind-Value="Input.PhoneNumbers[phoneIndex]" class="form-control" placeholder="Enter your phone number" />
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-outline-danger" @onclick="() => RemovePhoneNumber(phoneIndex)">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <button type="button" class="btn btn-outline-secondary mb-3" @onclick="AddPhoneNumber">Add phone number</button>
            <ValidationMessage For="() => Input.PhoneNumbers" class="text-danger" />
            <button type="submit" class="w-100 btn btn-lg btn-primary">Save</button>
        </EditForm>
    </div>
</div>

@code {
    private ApplicationUser user = default!;
    private string? username;
    private InputModel Input { get; set; } = new();
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        user = await UserManager.GetUserAsync(authenticationState.User)
            ?? throw new InvalidOperationException("The current user could not be loaded.");

        username = await UserManager.GetUserNameAsync(user);
        var phoneNumbers = (await UserPhoneService.GetPhoneNumbersAsync(user.Id)).ToArray();
        Input.PhoneNumbers = phoneNumbers.Length == 0 ? [""] : phoneNumbers.ToList();
    }

    private async Task OnValidSubmitAsync()
    {
        await UserPhoneService.UpdatePhoneNumbersAsync(user.Id, Input.PhoneNumbers);

        statusMessage = "Your profile has been updated";
    }

    private void AddPhoneNumber()
    {
        Input.PhoneNumbers.Add("");
    }

    private void RemovePhoneNumber(int index)
    {
        Input.PhoneNumbers.RemoveAt(index);

        if (Input.PhoneNumbers.Count == 0)
        {
            Input.PhoneNumbers.Add("");
        }
    }

    private sealed class InputModel : IValidatableObject
    {
        public List<string> PhoneNumbers { get; set; } = [""];

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var phoneAttribute = new PhoneAttribute();
            foreach (var phoneNumber in GetPhoneNumbers())
            {
                if (phoneNumber.Length > 20)
                {
                    yield return new ValidationResult("The phone number cannot exceed 20 characters.", [nameof(PhoneNumbers)]);
                    yield break;
                }

                if (!phoneAttribute.IsValid(phoneNumber))
                {
                    yield return new ValidationResult("The phone number is not valid.", [nameof(PhoneNumbers)]);
                    yield break;
                }
            }
        }

        public IReadOnlyCollection<string> GetPhoneNumbers()
        {
            return PhoneNumbers
                .Where(phoneNumber => !string.IsNullOrWhiteSpace(phoneNumber))
                .Select(phoneNumber => phoneNumber.Trim())
                .Distinct(StringComparer.Ordinal)
                .ToArray();
        }
    }
}
