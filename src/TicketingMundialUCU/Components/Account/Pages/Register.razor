@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using TicketingMundialUCU.Data
@using TicketingMundialUCU.Services

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject UserRegistrationService UserRegistrationService

<PageTitle>Crear cuenta</PageTitle>

<div class="auth-wrap">
    <div class="auth-card auth-card-wide">
        <div class="auth-brand">Ticketing <em>Mundial</em> UCU</div>

        <h1 class="auth-title">Crear cuenta</h1>
        <p class="auth-subtitle">Completá los datos para registrarte en el sistema.</p>

        <StatusMessage Message="@Message" />

        <EditForm Model="Input" asp-route-returnUrl="@ReturnUrl" method="post"
                  OnValidSubmit="RegisterUser" FormName="register">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3 small" role="alert" />

            <div class="auth-section">Cuenta</div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label for="Input.Email" class="form-label">Email</label>
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control"
                               autocomplete="username" aria-required="true"
                               placeholder="nombre@ejemplo.com" />
                    <ValidationMessage For="() => Input.Email" class="validation-message" />
                </div>
                <div class="col-md-4">
                    <label for="Input.Role" class="form-label">Rol</label>
                    <InputSelect @bind-Value="Input.Role" id="Input.Role" class="form-select" aria-required="true">
                        <option value="@UserRoles.General">Usuario general</option>
                        <option value="@UserRoles.Funcionario">Funcionario</option>
                        <option value="@UserRoles.Administrador">Administrador</option>
                    </InputSelect>
                    <ValidationMessage For="() => Input.Role" class="validation-message" />
                </div>
                <div class="col-md-6">
                    <label for="Input.Password" class="form-label">Contraseña</label>
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password"
                               class="form-control" autocomplete="new-password"
                               aria-required="true" placeholder="••••••••" />
                    <ValidationMessage For="() => Input.Password" class="validation-message" />
                </div>
                <div class="col-md-6">
                    <label for="Input.ConfirmPassword" class="form-label">Confirmar contraseña</label>
                    <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword"
                               class="form-control" autocomplete="new-password"
                               aria-required="true" placeholder="••••••••" />
                    <ValidationMessage For="() => Input.ConfirmPassword" class="validation-message" />
                </div>
            </div>

            <div class="auth-section">Documento</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="Input.TipoDocumento" class="form-label">Tipo</label>
                    <InputText @bind-Value="Input.TipoDocumento" id="Input.TipoDocumento"
                               class="form-control" aria-required="true"
                               placeholder="CI, Pasaporte, DNI…" />
                    <ValidationMessage For="() => Input.TipoDocumento" class="validation-message" />
                </div>
                <div class="col-md-4">
                    <label for="Input.NroDocumento" class="form-label">Número</label>
                    <InputText @bind-Value="Input.NroDocumento" id="Input.NroDocumento"
                               class="form-control" aria-required="true" placeholder="12345678" />
                    <ValidationMessage For="() => Input.NroDocumento" class="validation-message" />
                </div>
                <div class="col-md-4">
                    <label for="Input.PaisDocumento" class="form-label">País emisor</label>
                    <InputText @bind-Value="Input.PaisDocumento" id="Input.PaisDocumento"
                               class="form-control" aria-required="true" placeholder="Uruguay" />
                    <ValidationMessage For="() => Input.PaisDocumento" class="validation-message" />
                </div>
            </div>

            <div class="auth-section">Dirección</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="Input.PaisDireccion" class="form-label">País de residencia</label>
                    <InputText @bind-Value="Input.PaisDireccion" id="Input.PaisDireccion"
                               class="form-control" aria-required="true" placeholder="Uruguay" />
                    <ValidationMessage For="() => Input.PaisDireccion" class="validation-message" />
                </div>
                <div class="col-md-6">
                    <label for="Input.Localidad" class="form-label">Localidad</label>
                    <InputText @bind-Value="Input.Localidad" id="Input.Localidad"
                               class="form-control" aria-required="true" placeholder="Montevideo" />
                    <ValidationMessage For="() => Input.Localidad" class="validation-message" />
                </div>
                <div class="col-md-5">
                    <label for="Input.Calle" class="form-label">Calle</label>
                    <InputText @bind-Value="Input.Calle" id="Input.Calle"
                               class="form-control" aria-required="true" placeholder="Av. 18 de Julio" />
                    <ValidationMessage For="() => Input.Calle" class="validation-message" />
                </div>
                <div class="col-md-3">
                    <label for="Input.NroDireccion" class="form-label">Número</label>
                    <InputText @bind-Value="Input.NroDireccion" id="Input.NroDireccion"
                               class="form-control" aria-required="true" placeholder="1234" />
                    <ValidationMessage For="() => Input.NroDireccion" class="validation-message" />
                </div>
                <div class="col-md-4">
                    <label for="Input.CodigoPostal" class="form-label">Código postal</label>
                    <InputText @bind-Value="Input.CodigoPostal" id="Input.CodigoPostal"
                               class="form-control" aria-required="true" placeholder="11200" />
                    <ValidationMessage For="() => Input.CodigoPostal" class="validation-message" />
                </div>
                <div class="col-md-5">
                    <label for="Input.Telefono" class="form-label">
                        Teléfono <span class="text-muted fw-normal" style="font-size:.8rem">(opcional)</span>
                    </label>
                    <InputText @bind-Value="Input.Telefono" id="Input.Telefono"
                               class="form-control" placeholder="+598 99 123 456" />
                    <ValidationMessage For="() => Input.Telefono" class="validation-message" />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary btn-lg w-100">Crear cuenta</button>
            </div>
        </EditForm>

        <div class="auth-footer">
            ¿Ya tenés cuenta? <a href="Account/Login">Iniciar sesión</a>
        </div>
    </div>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    public async Task RegisterUser(EditContext editContext)
    {
        var result = await UserRegistrationService.RegisterUserAsync(
            new UserRegistrationData(
                Input.Email,
                Input.Password,
                Input.NroDocumento,
                Input.TipoDocumento,
                Input.PaisDocumento,
                Input.PaisDireccion,
                Input.Localidad,
                Input.Calle,
                Input.NroDireccion,
                Input.CodigoPostal,
                Input.Telefono,
                Input.Role));

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }

        Logger.LogInformation("User created a new account with password.");

        var user = await UserManager.FindByEmailAsync(Input.Email)
            ?? throw new InvalidOperationException("The user was created but could not be loaded by email.");
        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });

        await EmailSender.SendConfirmationLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        if (UserManager.Options.SignIn.RequireConfirmedAccount)
        {
            RedirectManager.RedirectTo(
                "Account/RegisterConfirmation",
                new() { ["email"] = Input.Email, ["returnUrl"] = ReturnUrl });
        }

        await SignInManager.SignInAsync(user, isPersistent: false);

        var targetUrl = ReturnUrl;
        if (string.IsNullOrWhiteSpace(targetUrl))
            targetUrl = "/dashboard";
        else if (!Uri.IsWellFormedUriString(targetUrl, UriKind.Relative))
            targetUrl = NavigationManager.ToBaseRelativePath(targetUrl);

        NavigationManager.NavigateTo(targetUrl, replace: true);
    }

    private sealed class InputModel : IValidatableObject
    {
        [Required]
        [EmailAddress]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required]
        [Display(Name = "Número de documento")]
        public string NroDocumento { get; set; } = "";

        [Required]
        [Display(Name = "Tipo de documento")]
        public string TipoDocumento { get; set; } = "";

        [Required]
        [Display(Name = "País del documento")]
        public string PaisDocumento { get; set; } = "";

        [Required]
        [Display(Name = "País de residencia")]
        public string PaisDireccion { get; set; } = "";

        [Required]
        [Display(Name = "Localidad")]
        public string Localidad { get; set; } = "";

        [Required]
        [Display(Name = "Calle")]
        public string Calle { get; set; } = "";

        [Required]
        [Display(Name = "Número de puerta")]
        public string NroDireccion { get; set; } = "";

        [Required]
        [Display(Name = "Código postal")]
        public string CodigoPostal { get; set; } = "";

        [Display(Name = "Teléfono")]
        public string Telefono { get; set; } = "";

        [Required]
        [Display(Name = "Rol")]
        public string Role { get; set; } = UserRoles.General;

        [Required]
        [StringLength(100, ErrorMessage = "La contraseña debe tener al menos {2} caracteres.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Contraseña")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirmar contraseña")]
        [Compare("Password", ErrorMessage = "La contraseña y su confirmación no coinciden.")]
        public string ConfirmPassword { get; set; } = "";

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!UserRoles.IsValid(Role))
                yield return new ValidationResult("El rol seleccionado no es válido.", [nameof(Role)]);
        }
    }
}
